# Netlify environment variables. Add the real values in Netlify's dashboard;
# do not commit an .env file with secrets.
NODE_ENV=production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/kisanmithra
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=90d
GEMINI_API_KEY=your-gemini-api-key
CLIENT_URL=https://your-vercel-project.vercel.app

# Enable these features only when their corresponding credentials are available.
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
